# ========================================================
# KEMI'S ARTISAN PANTRY & PROVISIONS — ENVIRONMENT CONFIG
# ========================================================

# 1. DATABASE (Supabase or Neon PostgreSQL)
# Example Supabase pooled URL (port 6543): postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Example Neon URL: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/kemis_pantry?schema=public"
# DIRECT_URL is optional (used for migrations if using Supabase connection pooler)
DIRECT_URL="postgresql://postgres:password@localhost:5432/kemis_pantry?schema=public"

# 2. NEXTAUTH / GOOGLE OAUTH 2.0 (Google Cloud Console)
# NextAuth base URL
NEXTAUTH_URL="http://localhost:3000"
# Generate a random 32-character string (e.g., openssl rand -base64 32)
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google Cloud Console Credentials
# APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# 3. CONFIRMATION EMAILS
# Option A: Mailgun (HNG primary checklist requirement)
MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxx"
MAILGUN_DOMAIN="sandboxxxxxxxxxxxxxxxxxxxxxxxxx.mailgun.org"
# 'us' or 'eu'
MAILGUN_HOST="api.mailgun.net"
MAIL_FROM="Kemi's Artisan Pantry <orders@sandboxxxxxxxxxxxxxxxxxxxxxxxxx.mailgun.org>"

# Option B: Resend (Instant alternative if Mailgun has account/verification hurdles)
# Get free key at https://resend.com (no credit card needed)
RESEND_API_KEY=""
